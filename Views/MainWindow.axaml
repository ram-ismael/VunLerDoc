<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VunLerDoc.ViewModels"
        xmlns:conv="using:VunLerDoc.Converters"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="VunLerDoc.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/logo.ico"
        MinWidth="900"
        MinHeight="620"
        Width="1240"
        Height="820"
        Background="#525659"
        DragDrop.AllowDrop="True">
  <Window.Resources>
    <conv:NotEmptyStringConverter x:Key="StringNotEmptyConverter" />
    <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
  </Window.Resources>

  <Grid RowDefinitions="52,*">
    <!-- Toolbar: dark, icon-only, matches Chrome's built-in PDF viewer layout. -->
    <Border Grid.Row="0" Background="#323639">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="6,0">

        <Button Grid.Column="0" Classes="toolbar-dark" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Mostrar/ocultar miniaturas">
          <materialIcons:MaterialIcon Kind="Menu" Width="20" Height="20" />
        </Button>

        <Button Grid.Column="1" Classes="toolbar-dark" Click="OpenPdfClick" ToolTip.Tip="Abrir PDF">
          <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20" />
        </Button>

        <TextBlock Grid.Column="2"
                   Text="{Binding DocumentName}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="440"
                   TextTrimming="CharacterEllipsis"
                   Foreground="#E8EAED"
                   FontSize="13" />

        <Button Grid.Column="3" Classes="toolbar-dark" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" ToolTip.Tip="Página anterior">
          <materialIcons:MaterialIcon Kind="ChevronLeft" Width="22" Height="22" />
        </Button>

        <Border Grid.Column="4" Background="#3C4043" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" MinWidth="60">
          <TextBlock Text="{Binding PageIndicator}" Foreground="#E8EAED" FontSize="12" HorizontalAlignment="Center" />
        </Border>

        <Button Grid.Column="5" Classes="toolbar-dark" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" ToolTip.Tip="Próxima página">
          <materialIcons:MaterialIcon Kind="ChevronRight" Width="22" Height="22" />
        </Button>

        <Button Grid.Column="6" Classes="toolbar-dark" Command="{Binding ZoomOutCommand}" IsEnabled="{Binding IsInteractive}" ToolTip.Tip="Diminuir zoom" Margin="10,0,0,0">
          <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="20" Height="20" />
        </Button>

        <Button Grid.Column="7" Classes="toolbar-dark" Command="{Binding ResetZoomCommand}" IsEnabled="{Binding IsInteractive}" ToolTip.Tip="Repor zoom (100%)">
          <TextBlock Text="{Binding ZoomLabel}" FontSize="12" MinWidth="42" HorizontalAlignment="Center" />
        </Button>

        <Button Grid.Column="8" Classes="toolbar-dark" Command="{Binding ZoomInCommand}" IsEnabled="{Binding IsInteractive}" ToolTip.Tip="Aumentar zoom">
          <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="20" Height="20" />
        </Button>

        <Button Grid.Column="9" Classes="toolbar-dark" IsEnabled="{Binding IsInteractive}" ToolTip.Tip="Ajustar" Margin="10,0,0,0">
          <materialIcons:MaterialIcon Kind="FitToPageOutline" Width="20" Height="20" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="Ajustar à largura" Click="FitWidthClick" />
              <MenuItem Header="Ajustar à página" Click="FitPageClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Grid.Column="10" Classes="toolbar-dark" Command="{Binding RotateClockwiseCommand}" IsEnabled="{Binding IsInteractive}" ToolTip.Tip="Rodar">
          <materialIcons:MaterialIcon Kind="RotateRight" Width="20" Height="20" />
        </Button>

        <Button Grid.Column="11" Classes="toolbar-dark" Click="SaveAsClick" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Transferir cópia">
          <materialIcons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20" />
        </Button>

        <Button Grid.Column="12" Classes="toolbar-dark" Command="{Binding PrintCommand}" IsEnabled="{Binding CanPrint}" ToolTip.Tip="Imprimir">
          <materialIcons:MaterialIcon Kind="PrinterOutline" Width="20" Height="20" />
        </Button>
      </Grid>
    </Border>

    <!-- Content: optional thumbnail rail + continuous-scroll page list. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

      <Border Grid.Column="0" Background="#2B2D2F" Width="176" IsVisible="{Binding IsSidebarVisible}">
        <ListBox Name="ThumbnailList"
                 ItemsSource="{Binding Pages}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="12"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="4" />
              <Setter Property="Margin" Value="0,0,0,10" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Background" Value="#4A4E51" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PdfPageItemViewModel">
              <StackPanel Spacing="4" HorizontalAlignment="Center" Tag="{Binding Index}" PointerPressed="ThumbnailPressed">
                <Border Background="#F8F9FA" BorderBrush="#4A4E51" BorderThickness="1" Padding="0" Width="142" Height="184">
                  <Panel>
                    <Viewbox Stretch="Uniform">
                      <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                        <Image Source="{Binding Thumbnail}"
                               Width="{Binding UnrotatedDisplayWidth}"
                               Height="{Binding UnrotatedDisplayHeight}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Fill"
                               RenderTransformOrigin="50%,50%"
                               RenderOptions.BitmapInterpolationMode="HighQuality">
                          <Image.RenderTransform>
                            <RotateTransform Angle="{Binding RotationDegrees}" />
                          </Image.RenderTransform>
                        </Image>
                      </Grid>
                    </Viewbox>
                    <Border IsVisible="{Binding IsThumbnailPlaceholderVisible}" Background="#F1F3F4">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                        <ProgressBar Width="72" Height="3" IsIndeterminate="True" />
                        <TextBlock Text="{Binding PageNumber}" Foreground="#80868B" FontSize="10" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding PageNumber}" Foreground="#B7BABD" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Grid Grid.Column="1" Background="#525659">
        <ScrollViewer Name="PageScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="PageScrollViewerScrollChanged"
                      IsVisible="{Binding IsDocumentReady}">
          <ListBox Name="PagesList"
                    ItemsSource="{Binding Pages}"
                    Background="Transparent"
                    Padding="0,28"
                    HorizontalAlignment="Center"
                    SelectionMode="Single"
                    ContainerPrepared="PagesListContainerPrepared"
                    ContainerClearing="PagesListContainerClearing">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PdfPageItemViewModel">
                <Border Background="White"
                        BoxShadow="0 6 18 0 #33000000"
                        Width="{Binding DisplayWidth}"
                        Height="{Binding DisplayHeight}"
                        Margin="0,0,0,16"
                        PointerPressed="PdfPagePointerPressed"
                        PointerMoved="PdfPagePointerMoved"
                        PointerExited="PdfPagePointerExited">
                  <Panel>
                    <Image Source="{Binding DisplayImage}"
                           Width="{Binding UnrotatedDisplayWidth}"
                           Height="{Binding UnrotatedDisplayHeight}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Fill"
                           RenderTransformOrigin="50%,50%"
                           RenderOptions.BitmapInterpolationMode="HighQuality">
                      <Image.RenderTransform>
                        <RotateTransform Angle="{Binding RotationDegrees}" />
                      </Image.RenderTransform>
                    </Image>

                    <Border IsVisible="{Binding IsPlaceholderVisible}" Background="#F8F9FA">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                        <ProgressBar Width="110" Height="3" IsIndeterminate="True" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                          <TextBlock Text="A preparar página" Foreground="#74787C" FontSize="12" />
                          <TextBlock Text="{Binding PageNumber}" Foreground="#74787C" FontSize="12" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsRendering}"
                            Background="#D9FFFFFF"
                            BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="12"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,4">
                      <TextBlock Text="A atualizar…" Foreground="#5F6368" FontSize="11" />
                    </Border>
                  </Panel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>

        <StackPanel IsVisible="{Binding HasDocument, Converter={StaticResource BooleanNegationConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="90">
          <TextBlock Text="VunLerDoc" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" />
          <TextBlock Text="Abra um ficheiro PDF para começar" Margin="0,10,0,0" FontSize="15" Foreground="#C6C9CC" HorizontalAlignment="Center" />
          <Button Content="Abrir PDF" Click="OpenPdfClick" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="24,11" />
        </StackPanel>

        <!-- Native first-paint loader: it only covers the reader while page 1 is being prepared. -->
        <Border IsVisible="{Binding IsOpeningDocument}" Background="#525659">
          <Border Background="#E8323639"
                  BorderBrush="#3344484B" BorderThickness="1"
                  CornerRadius="12" Padding="22,18" Width="330"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding DocumentName}"
                         Foreground="#F1F3F4" FontSize="14" FontWeight="SemiBold"
                         HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="286" />
              <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" Foreground="#8AB4F8" Background="#45494D" />
              <TextBlock Text="{Binding StatusText}" Foreground="#BDC1C6" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Border>

        <!-- Once page 1 is visible, this compact chip reports low-priority background preparation
             without blocking scrolling, zooming, navigation, printing or the thumbnail rail. -->
        <Border IsVisible="{Binding IsPriming}"
                Background="#E8323639" BorderBrush="#3344484B" BorderThickness="1"
                CornerRadius="12" Padding="12,8" Width="310"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding BackgroundStatusText}" Foreground="#E8EAED" FontSize="11" HorizontalAlignment="Center" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding LoadProgress}" Height="3" CornerRadius="2" Foreground="#8AB4F8" Background="#45494D" />
          </StackPanel>
        </Border>

        <Border Background="#E8323639" CornerRadius="10" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0" IsVisible="{Binding IsBusy}">
          <TextBlock Text="A processar…" Foreground="White" />
        </Border>

        <Border Background="#FFF0F0" BorderBrush="#F3C3C3" BorderThickness="1" CornerRadius="8" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" IsVisible="{Binding ErrorText, Converter={StaticResource StringNotEmptyConverter}}">
          <TextBlock Text="{Binding ErrorText}" Foreground="#9A2E2E" MaxWidth="700" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>